<launch>
  <arg name="gui" default="true" />
  <arg name="rerun" default="false" />
  <arg name="map_generator" default="true" />
  <arg name="model_path" default="" />
  <arg name="mission_points" default="$(find-pkg-share perse_bringup)/config/mission_points.yaml" />
  <arg name="use_sim_time" default="false" />

  <arg name="perse_mujoco_params" default="$(find-pkg-share perse_mujoco)/config/perse_mujoco.yaml" />
  <arg name="sim_params" default="$(var perse_mujoco_params)" />
  <arg name="perse_properties" default="$(find-pkg-share perse_bringup)/config/perse_properties.yaml" />
  <arg name="topics" default="$(find-pkg-share perse_bringup)/config/topics.yaml" />
  <arg name="rerun_config" default="$(find-pkg-share perse_bringup)/config/rerun.yaml" />

  <!-- Gerador dinâmico de mapas em Python (independente, atende via Trigger service) -->
  <group if="$(var map_generator)">
    <node pkg="perse_mujoco" exec="map_generator_node.py" name="map_generator_node" output="screen">
      <param from="$(var topics)" />
      <param name="mission_points" value="$(var mission_points)" />
    </node>
  </group>

  <!-- Nó principal de simulação MuJoCo C++ -->
  <node pkg="perse_mujoco" exec="perse_mujoco_node" name="perse_mujoco_node" output="screen">
    <param from="$(var sim_params)" />
    <param from="$(var perse_properties)" />
    <param from="$(var topics)" />
    <param from="$(var perse_mujoco_params)" />
    <param name="model_path" value="$(var model_path)" />
    <param name="mission_points" value="$(var mission_points)" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
  </node>

  <!-- Transformações Estáticas TF (Paridade com Webots e Robô Real) -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="odom_map_broadcaster"
        args="0 0 0 0 0 0 map odom" output="screen" />

  <node pkg="tf2_ros" exec="static_transform_publisher" name="base_lidar_broadcaster"
        args="0.077 0 0.21 0 0 0 base_link lidar_link" output="screen" />

  <node pkg="tf2_ros" exec="static_transform_publisher" name="base_camera_broadcaster"
        args="0.31 0 0.18 -1.5707963 0 -1.5707963 base_link camera_link" output="screen" />

  <!-- Visualizador GLFW Nativo MuJoCo (desacoplado da simulação) -->
  <group if="$(var gui)">
    <node pkg="perse_mujoco" exec="perse_mujoco_viewer" name="perse_mujoco_viewer"
          output="screen" args="$(var model_path)" />
  </group>

  <!-- Visualizador Rerun C++ MuJoCo (quando rerun ativo e gui desativado) -->
  <group unless="$(var gui)">
    <group if="$(var rerun)">
      <node pkg="perse_mujoco" exec="perse_mujoco_rerun" name="perse_mujoco_rerun"
            output="screen">
        <param from="$(var perse_mujoco_params)" />
        <param from="$(var rerun_config)" />
        <param from="$(var topics)" />
        <param name="model_path" value="$(var model_path)" />
        <param name="rerun.enable" value="$(var rerun)" />
      </node>
    </group>
  </group>
</launch>

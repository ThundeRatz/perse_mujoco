<mujoco model="perse_test_scene">
  <compiler angle="radian" meshdir="meshes/"/>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25" ipd="0" offwidth="1280" offheight="960"/>
  </visual>

  <!-- Inclui a definição completa do robô Perse -->
  <include file="perse_robot.xml"/>

  <asset>
    <!-- Texturas de Ambiente e Solo -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.05 0.1" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.12 0.15 0.18" rgb2="0.18 0.22 0.26"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" reflectance="0.1"/>

    <!-- Materiais específicos dos elementos da arena -->
    <material name="cone_mat" rgba="1.0 0.4 0.0 1.0" reflectance="0.3"/>
    <material name="box_mat" rgba="0.2 0.6 1.0 1.0" reflectance="0.4"/>
  </asset>

  <worldbody>
    <!-- Iluminação Direcional e Pontual com Sombras -->
    <light directional="true" pos="0 0 5" dir="0 0 -1" castshadow="true" diffuse="0.8 0.8 0.8"/>
    <light directional="false" pos="3 -3 4" dir="-0.5 0.5 -1" castshadow="true" diffuse="0.4 0.4 0.4"/>

    <!-- Chao / Grid -->
    <geom name="ground" type="plane" size="20 20 0.1" material="grid_mat" friction="1.0 0.05 0.001"/>

    <!-- Obstáculos e Balizas na Arena para Testes de Esterçamento e Impacto -->
    <body name="cone_1" pos="2.0 0.5 0.15">
      <geom name="cone_geom_1" type="cylinder" size="0.08 0.15" material="cone_mat" mass="1.0" condim="3"/>
    </body>
    <body name="cone_2" pos="2.0 -0.5 0.15">
      <geom name="cone_geom_2" type="cylinder" size="0.08 0.15" material="cone_mat" mass="1.0" condim="3"/>
    </body>
    <body name="obstacle_box" pos="3.5 0.0 0.15">
      <freejoint name="obstacle_joint"/>
      <geom name="obstacle_box_geom" type="box" size="0.2 0.3 0.15" material="box_mat" mass="2.0" condim="3"/>
    </body>
  </worldbody>
</mujoco>
